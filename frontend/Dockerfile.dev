# Development stage
# FROM node:20-alpine
FROM node:20-bullseye

# Set work directory
WORKDIR /app

# Run as the image's non-root `node` user, renumbered to the developer's host
# UID/GID. docker-compose.dev.yml bind-mounts ./frontend over /app, and Next.js
# writes next-env.d.ts into it (`next build` also writes tsconfig.tsbuildinfo),
# so on native Linux the container user must own the checkout or those writes
# fail with EACCES. Docker Desktop and OrbStack mask bind-mount ownership, which
# is why this only shows on Linux. The defaults match the first Linux user and
# the image's own node user; override with HOST_UID/HOST_GID in .env (see
# env.example) and rebuild. `-o` tolerates an ID that already exists in the
# image, e.g. a macOS primary group of 20.
ARG HOST_UID=1000
ARG HOST_GID=1000
RUN if [ "$HOST_UID" != "$(id -u node)" ] || [ "$HOST_GID" != "$(id -g node)" ]; then \
      groupmod -o -g "$HOST_GID" node && usermod -o -u "$HOST_UID" -g "$HOST_GID" node; \
    fi
RUN mkdir -p /app/.next && chown -R node:node /app/.next

# Install dependencies
# RUN npm install -g sonarqube-scanner 
# RUN apt-get update && apt-get install -y curl

# Copy the rest of the application
COPY --chown=node:node . /app

# Assign permission
RUN chown node:node /app

# Switch to non-root user
USER node
RUN npm install

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["npm", "run", "dev"]
